# Azure CLI service-principal handoff — DO NOT add real values to this file.
# Supply the two blank values through the secure project-secret fields instead.

# Known from the existing Azure setup
AZURE_CLIENT_ID=6250b570-898d-4bc0-8f8b-910078d4c7c5
AZURE_SUBSCRIPTION_ID=5974c845-4443-4b80-a0cd-b83696573637

# Required from Microsoft Entra ID > App registrations > new registraion form > Overview
AZURE_TENANT_ID=

# Required from Certificates & secrets. Use the secret VALUE, never the secret ID.
# This value is shown only once when a secret is created.
AZURE_CLIENT_SECRET=

# After secure injection, the first command is read-only:
# az login --service-principal --username "$AZURE_CLIENT_ID" --password "$AZURE_CLIENT_SECRET" --tenant "$AZURE_TENANT_ID"
# az account show --subscription "$AZURE_SUBSCRIPTION_ID" --output table
