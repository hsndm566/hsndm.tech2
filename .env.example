# Core production configuration
JWT_SECRET=replace_with_a_long_random_value
DATABASE_URL=mysql://user:password@host:3306/database

# Leave blank when the browser and API share an origin. Set this to the public
# API origin only when the frontend is deployed separately.
VITE_API_BASE_URL=
PORT=3000

# AI provider
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Observability and analytics
SENTRY_DSN=
VITE_SENTRY_DSN=
VITE_GA_MEASUREMENT_ID=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com
VITE_PUBLIC_SITE_URL=https://www.hsndm.tech

# Product integrations
# Chatwoot's Website Inbox token is a public widget identifier, not an admin API
# credential. Keep Heroku/Chatwoot admin tokens server-side.
VITE_ENABLE_CHAT_WIDGET=false
VITE_CHATWOOT_BASE_URL=
VITE_CHATWOOT_WEBSITE_TOKEN=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=apply@hsndm.tech
BREVO_SENDER_NAME=AutoApply SA
JOB_DISCOVERY_ENDPOINT=
DODO_PAYMENTS_API_KEY=
DODO_PAYMENT_RETURN_URL=

# Cloudflare R2 storage
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Optional credential health checks. Keep disabled in ordinary test runs.
RUN_LIVE_CREDENTIAL_TESTS=false
RUN_BREVO_CREDENTIAL_CHECK=false
RUN_EXTERNAL_GROQ_HEALTH=false
RUN_SENTRY_DSN_CHECK=false

# Supabase customer authentication
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_LEGACY_ID_MAP={}

# Legacy Manus/Forge compatibility. These are not required for customer
# authentication. Leave unset unless a retained machine-only integration needs
# them during migration.
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Local infrastructure scripts only. Prefer a scoped API token over the global
# key and never set these in a browser-exposed VITE_ variable.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_EMAIL=
CLOUDFLARE_GLOBAL_API_KEY=
